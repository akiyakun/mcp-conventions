OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generate a separate token per MCP; do not use your OpenAI key here.
EXAMPLE_MCP_TOKEN=
# Default is localhost only. For LAN use, set BOTH to the NAS's LAN IP.
MCP_BIND_IP=127.0.0.1
SERVER_IP=127.0.0.1
# Host port only; the container listens on 8000.
MCP_PORT=8199
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
EXAMPLE_MAX_OUTPUT_TOKENS=800
EXAMPLE_WINDOW_SECONDS=600
EXAMPLE_MAX_CALLS_PER_WINDOW=3
EXAMPLE_MAX_CALLS_PER_DAY=20
EXAMPLE_BUDGET_TIMEZONE=Asia/Tokyo
